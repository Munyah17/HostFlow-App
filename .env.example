# HostFlow environment configuration.
# Copy to .env (the installer writes this file automatically).
# This file is NEVER overwritten by deployments.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://billing.example.com
# 32-byte random key, base64 encoded. Used to encrypt stored API credentials.
# Generate with: php bin/hostflow key:generate
APP_KEY=
APP_TIMEZONE=Africa/Harare

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hostflow
DB_USERNAME=hostflow
DB_PASSWORD=

# Optional token protecting the web-triggered cron endpoint (/cron/run?token=...).
# Leave empty to disable the web endpoint and use the CLI cron only (recommended).
CRON_WEB_TOKEN=
